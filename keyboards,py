from aiogram.types import ReplyKeyboardMarkup, KeyboardButton, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.utils.keyboard import ReplyKeyboardBuilder, InlineKeyboardBuilder

def get_main_menu():
    """Главное меню пользователя"""
    builder = ReplyKeyboardBuilder()
    builder.add(KeyboardButton(text="🎧 Поддержка"))
    builder.add(KeyboardButton(text="💬 Общение"))
    builder.add(KeyboardButton(text="👤 Стать администратором"))
    builder.add(KeyboardButton(text="⚙️ Тех. поддержка"))
    builder.add(KeyboardButton(text="📜 Правила пользования"))
    builder.adjust(2, 2, 1)
    return builder.as_markup(resize_keyboard=True)

def get_gender_selection():
    """Выбор пола"""
    builder = ReplyKeyboardBuilder()
    builder.add(KeyboardButton(text="👨 Мужской"))
    builder.add(KeyboardButton(text="👩 Женский"))
    builder.add(KeyboardButton(text="🔮 Не важно"))
    builder.adjust(2, 1)
    return builder.as_markup(resize_keyboard=True)

def get_listener_main_menu():
    """Главное меню слушателя"""
    builder = ReplyKeyboardBuilder()
    builder.add(KeyboardButton(text="📊 Статистика"))
    builder.add(KeyboardButton(text="📋 Список запросов"))
    builder.add(KeyboardButton(text="⚙️ Настройки"))
    builder.add(KeyboardButton(text="🔄 Передать чат"))
    builder.add(KeyboardButton(text="⏹️ Завершить чат"))
    builder.adjust(2, 2, 1)
    return builder.as_markup(resize_keyboard=True)

def get_admin_panel():
    """Админ-панель"""
    builder = InlineKeyboardBuilder()
    builder.add(InlineKeyboardButton(text="👤 Управление пользователями", callback_data="admin_users"))
    builder.add(InlineKeyboardButton(text="🎧 Управление слушателями", callback_data="admin_listeners"))
    builder.add(InlineKeyboardButton(text="📊 Статистика", callback_data="admin_stats"))
    builder.add(InlineKeyboardButton(text="📢 Рассылка", callback_data="admin_broadcast"))
    builder.add(InlineKeyboardButton(text="⚠️ Модерация", callback_data="admin_moderation"))
    builder.add(InlineKeyboardButton(text="⭐ Рейтинги", callback_data="admin_ratings"))
    builder.adjust(1)
    return builder.as_markup()
